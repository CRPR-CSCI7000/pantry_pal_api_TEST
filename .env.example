DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=pantry_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Or use Railway's DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# External APIs
OPENAI_API_KEY=
GOUPC_API_KEY=

# Rate limiting for Go-UPC
RATE_LIMIT_REQUESTS=1
RATE_LIMIT_WINDOW=1

# Email worker (pantrypal-email-worker)
EMAIL_WORKER_URL=http://localhost:4000
EMAIL_WORKER_API_KEY=
